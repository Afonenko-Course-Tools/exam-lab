location = /install/enroll {
    allow REPLACE_WITH_EXACT_CLIENT_CIDR;
    deny all;
    limit_except POST { deny all; }

    access_log off;
    client_max_body_size 512;
    client_body_timeout 5s;
    proxy_connect_timeout 3s;
    proxy_read_timeout 8s;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header X-Exam-Teacher-Proxy REPLACE_WITH_EXISTING_PROXY_TOKEN;
    proxy_pass http://127.0.0.1:21651/install/enroll;
}
