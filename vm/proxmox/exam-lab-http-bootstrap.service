[Unit]
Description=ExamLab HTTP bootstrap on pilot VM 103
Wants=network-online.target
After=network-online.target nftables.service

[Service]
ExecStartPre=/usr/sbin/nginx -t -c /etc/exam-lab-bootstrap/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/exam-lab-bootstrap/nginx.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -s reload -c /etc/exam-lab-bootstrap/nginx.conf
Restart=on-failure

[Install]
WantedBy=multi-user.target
