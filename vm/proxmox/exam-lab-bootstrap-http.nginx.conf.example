user www-data;
worker_processes 1;
pid /run/exam-lab-http-bootstrap.pid;
error_log stderr warn;

events { worker_connections 128; }

http {
    access_log off;

    server {
        listen 10.135.250.231:80;
        server_name 10.135.250.231;

        location = / {
            rewrite ^ /Start-ExamLab.cmd last;
        }

        location = /Start-ExamLab.cmd {
            WINDOWS_CLIENT_NETWORKS
            deny all;
            limit_except GET { deny all; }
            alias /srv/exam-lab-bootstrap/Start-ExamLab.cmd;
            types {}
            default_type application/octet-stream;
            add_header Content-Disposition 'attachment; filename="Start-ExamLab.cmd"';
            add_header Cache-Control 'no-store';
        }

        location / { return 404; }
    }
}
