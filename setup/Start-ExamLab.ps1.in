[CmdletBinding()]
param(
    [ValidateSet('Apply','Verify')][string]$Action = 'Apply',
    [switch]$Offline
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
# The launcher runs this verified entry from an administrators-only directory.
$diagnosticDirectory = $env:EXAMLAB_DIAGNOSTICS_DIR
if (-not $diagnosticDirectory -or [IO.Path]::GetDirectoryName($PSCommandPath) -ine $diagnosticDirectory) {
    throw 'Start ExamLab through the verified Start-ExamLab.cmd.'
}
$diagnosticReport = Join-Path $diagnosticDirectory 'report'

@DIAGNOSTICS_COLLECTOR@

$examLabStartCertificates = [Collections.Generic.List[Security.Cryptography.X509Certificates.X509Certificate2]]::new()
$transcribing = $false
$childLock = [IO.File]::Open((Join-Path $diagnosticDirectory 'child.lock'), 'CreateNew', 'ReadWrite', 'None')
try {
    Start-Transcript -LiteralPath (Join-Path $diagnosticReport 'powershell-transcript.log') | Out-Null
    $transcribing = $true
    @ROOT_TRUST@
    @LOAD_ROOTS@
    @INSTALLER@
} catch {
    $failure = $_
    try {
        $failure | Format-List * -Force | Out-String -Width 360 |
            Set-Content -LiteralPath (Join-Path $diagnosticReport 'powershell-error.log') -Encoding utf8
        $failure.Exception.ToString() |
            Set-Content -LiteralPath (Join-Path $diagnosticReport 'powershell-exception.log') -Encoding utf8
    } catch { Write-Warning "Could not write the PowerShell failure: $_" }
    [Console]::Error.WriteLine($failure.ToString())
    exit 1
} finally {
    foreach ($certificate in $examLabStartCertificates) { $certificate.Dispose() }
    if ($transcribing) { try { Stop-Transcript | Out-Null } catch { Write-Warning $_ } }
    try { Collect-ExamLabDiagnostics -DiagnosticDirectory $diagnosticDirectory }
    catch { [Console]::Error.WriteLine("Additional diagnostics unavailable: $($_.Exception.Message)") }
    finally { $childLock.Dispose() }
}
