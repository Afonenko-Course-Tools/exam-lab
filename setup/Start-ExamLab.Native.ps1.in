$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2

function Read-EmbeddedPowerShell([string]$Tag) {
    $pattern = '(?m)^(?:# )?rem ' + [regex]::Escape($Tag) + ':([A-Za-z0-9+/=]+)\r?$'
    $parts = [regex]::Matches($launcherText, $pattern)
    if (-not $parts.Count) { throw 'The verified launcher is missing a PowerShell payload.' }
    $encoded = ($parts | ForEach-Object { $_.Groups[1].Value }) -join ''
    return ,([Convert]::FromBase64String($encoded))
}

function Invoke-ExamLabInventory([string]$OutputPath) {
    $inventory = [ScriptBlock]::Create([Text.Encoding]::UTF8.GetString((Read-EmbeddedPowerShell 'EXAMLAB_INVENTORY')))
    & $inventory -OutputPath $OutputPath -Release $release -Attempt $attempt -CheckExit $result
}

if (@CHECK_ONLY@) {
    $action = 'Check'
    $options = @()
} else {
    $action = if ($env:EXAMLAB_ARG1) { $env:EXAMLAB_ARG1 } else { 'Apply' }
    $options = @($env:EXAMLAB_ARG2, $env:EXAMLAB_ARG3 | Where-Object { $_ })
    if ($action -notin 'Check', 'Prefetch', 'Apply', 'Verify' -or $env:EXAMLAB_ARG4 -or
        @($options | Where-Object { $_ -notin '--offline', '--elevated' }).Count -or
        @($options | Select-Object -Unique).Count -ne $options.Count) {
        throw 'Usage: Start-ExamLab.cmd [Check|Prefetch|Apply|Verify] [--offline]'
    }
}
$offline = $options -contains '--offline'
$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
$admin = [Security.Principal.WindowsPrincipal]::new($identity).IsInRole(
    [Security.Principal.WindowsBuiltInRole]::Administrator)
if (-not $admin -and $action -ne 'Check') {
    if ($options -contains '--elevated') { throw 'Run the verified Start-ExamLab.cmd as an administrator.' }
    $arguments = "$action --elevated"
    if ($offline) { $arguments += ' --offline' }
    Start-Process -FilePath $env:EXAMLAB_LAUNCHER -ArgumentList $arguments -Verb RunAs
    exit 100
}

@BOOTSTRAP_PRIVATE_PATHS@

$release = '@REVISION@'
$baseUrl = '@PREFETCH_BASE_URL@'
$toolPath = "exam-lab-$release/tools"
$controllerCa = [Convert]::FromBase64String('@CONTROLLER_CA_BASE64@')
$receiver = "$baseUrl/diagnostics @CONTROLLER_CA_SHA256@"
$runtime = @{ Name='@PWSH_FILE@'; SHA256='@PWSH_SHA256@'; Bytes=@PWSH_BYTES@; Tool=$true }
$installer = @{ Name='@INSTALLER_FILE@'; SHA256='@INSTALLER_SHA256@'; Bytes=@INSTALLER_BYTES@; Tool=$false }
$bundle = @{ Name='@BUNDLE_FILE@'; SHA256='@BUNDLE_SHA256@'; Bytes=@BUNDLE_BYTES@;
    ExpandedBytes=@BUNDLE_EXPANDED_BYTES@; Tool=$false }
$tools = @BOOTSTRAP_TOOLS@
foreach ($tool in $tools) { $tool.Tool = $true }
$programFiles = [Environment]::GetFolderPath('ProgramFiles')
$reports = Join-Path $programFiles 'ExamLabSetupReports'
$cache = Join-Path $reports 'Downloads'
$pwsh = Join-Path $programFiles 'PowerShell\7\pwsh.exe'
$sourceDirectory = [IO.Path]::GetDirectoryName($env:EXAMLAB_LAUNCHER)
$attempt = [Guid]::NewGuid().ToString('N')
$attemptParent = if ($admin) { $programFiles } else { [Environment]::GetFolderPath('LocalApplicationData') }
$work = Join-Path $attemptParent "ExamLabBootstrap-$attempt"
$env:PSModulePath = Join-Path $PSHOME 'Modules'
Set-Location -LiteralPath ([Environment]::GetFolderPath('System'))
$report = Join-Path $work 'report'
$transcribing = $false
$lock = $null
$attemptLock = $null
$result = 1
$sharedCacheRead = $false
$transportStarted = $false
$bootstrapTypesLoaded = $false

function Initialize-BootstrapTypes {
    if ($script:bootstrapTypesLoaded) { return }
    $previousTemp = $env:TEMP
    $previousTmp = $env:TMP
    try {
        $env:TEMP = $env:TMP = $work
        Add-Type -TypeDefinition @'
using System;
using System.ComponentModel;
using System.Runtime.InteropServices;
using System.Text;
using System.Net;
using System.Net.Security;
using System.Security.Cryptography.X509Certificates;

public sealed class ExamLabBootstrapVolume {
    public string Id { get; private set; }
    public string MountPath { get; private set; }
    public long FreeBytes { get; private set; }

    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern bool GetVolumePathName(string path, StringBuilder mountPath, uint size);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern bool GetVolumeNameForVolumeMountPoint(string mountPath, StringBuilder name, uint size);
    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
    private static extern bool GetDiskFreeSpaceEx(string path, out ulong callerFree, out ulong total, out ulong totalFree);

    public static ExamLabBootstrapVolume Read(string directory) {
        var mountPath = new StringBuilder(32768);
        var identity = new StringBuilder(64);
        ulong available, total, free;
        if (!GetVolumePathName(directory, mountPath, (uint)mountPath.Capacity) ||
            !GetVolumeNameForVolumeMountPoint(mountPath.ToString(), identity, (uint)identity.Capacity) ||
            !GetDiskFreeSpaceEx(directory, out available, out total, out free))
            throw new Win32Exception(Marshal.GetLastWin32Error());
        return new ExamLabBootstrapVolume {
            Id = identity.ToString(), MountPath = mountPath.ToString(), FreeBytes = checked((long)available)
        };
    }
}

public sealed class ExamLabBootstrapTransport : IDisposable {
    private readonly X509Certificate2 root;

    public ExamLabBootstrapTransport(byte[] certificate) {
        root = new X509Certificate2(certificate);
    }

    private bool ValidateServer(object sender, X509Certificate certificate, X509Chain supplied, SslPolicyErrors errors) {
        if (certificate == null || (errors & ~SslPolicyErrors.RemoteCertificateChainErrors) != 0) return false;
        using (var leaf = new X509Certificate2(certificate))
        using (var chain = new X509Chain()) {
            chain.ChainPolicy.ExtraStore.Add(root);
            if (supplied != null)
                foreach (X509ChainElement element in supplied.ChainElements)
                    chain.ChainPolicy.ExtraStore.Add(element.Certificate);
            chain.ChainPolicy.VerificationFlags = X509VerificationFlags.AllowUnknownCertificateAuthority;
            chain.ChainPolicy.RevocationMode = X509RevocationMode.NoCheck;
            chain.ChainPolicy.ApplicationPolicy.Add(new System.Security.Cryptography.Oid("1.3.6.1.5.5.7.3.1"));
            if (!chain.Build(leaf) || chain.ChainElements.Count < 2) return false;
            foreach (var status in chain.ChainStatus)
                if ((status.Status & ~X509ChainStatusFlags.UntrustedRoot) != 0) return false;
            var anchor = chain.ChainElements[chain.ChainElements.Count - 1].Certificate;
            return Convert.ToBase64String(anchor.RawData) == Convert.ToBase64String(root.RawData);
        }
    }

    public HttpWebRequest Request(string url) {
        var uri = new Uri(url);
        if (uri.Scheme != Uri.UriSchemeHttps) throw new ArgumentException("HTTPS is required.");
        var request = (HttpWebRequest)WebRequest.Create(uri);
        request.AllowAutoRedirect = false;
        request.Proxy = null;
        request.ServerCertificateValidationCallback = ValidateServer;
        request.Timeout = 30000;
        request.ReadWriteTimeout = 120000;
        return request;
    }

    public void Dispose() { root.Dispose(); }
}
'@
    } finally {
        $env:TEMP = $previousTemp
        $env:TMP = $previousTmp
    }
    $script:bootstrapTypesLoaded = $true
}

function Start-BootstrapTransport {
    if ($script:transportStarted) { return }
    Initialize-BootstrapTypes
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
    $script:transport = [ExamLabBootstrapTransport]::new($controllerCa)
    $script:transportStarted = $true
}

function Test-Artifact([string]$Path, $Artifact) {
    if (-not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $false }
    (Get-Item -LiteralPath $Path -Force).Length -eq $Artifact.Bytes -and
        (Get-FileHash -LiteralPath $Path -Algorithm SHA256).Hash -ieq $Artifact.SHA256
}

function Get-SuppliedArtifact($Artifact) {
    $folders = if ($Artifact.Tool) { 'tools', $toolPath.Replace('/', '\') } else { '.' }
    foreach ($folder in $folders) {
        $supplied = Join-Path (Join-Path $sourceDirectory $folder) $Artifact.Name
        if (Test-Path -LiteralPath $supplied -PathType Leaf) { return $supplied }
    }
}

function Receive-Artifact($Artifact, [string]$Partial) {
    Start-BootstrapTransport
    $relative = if ($Artifact.Tool) { "$toolPath/$($Artifact.Name)" } else { $Artifact.Name }
    $request = $transport.Request("$baseUrl/$relative")
    $offset = 0L
    if (Test-Path -LiteralPath $Partial) {
        Assert-ExamLabProtectedPath $Partial
        $offset = (Get-Item -LiteralPath $Partial -Force).Length
        if ($offset -ge $Artifact.Bytes) { $offset = 0L }
    }
    if ($offset) { $request.AddRange($offset) }
    $response = $null
    $source = $null
    $target = $null
    $activity = 'Downloading ' + $Artifact.Name
    try {
        try { $response = $request.GetResponse() }
        catch [Net.WebException] {
            if ($_.Exception.Response) {
                try {
                    if ($offset -and [int]$_.Exception.Response.StatusCode -eq 416) {
                        [IO.File]::Delete($Partial)
                        return Receive-Artifact $Artifact $Partial
                    }
                } finally { $_.Exception.Response.Dispose() }
            }
            throw
        }
        if ($response.StatusCode -eq [Net.HttpStatusCode]::OK) {
            $offset = 0L
        } elseif ($response.StatusCode -eq [Net.HttpStatusCode]::PartialContent -and $offset) {
            if ($response.Headers['Content-Range'] -cne "bytes $offset-$($Artifact.Bytes - 1)/$($Artifact.Bytes)") {
                throw "Unexpected Content-Range for $($Artifact.Name)."
            }
        } else { throw "Unexpected HTTP status $([int]$response.StatusCode) for $($Artifact.Name)." }
        if ($response.ContentLength -ge 0 -and $response.ContentLength -ne $Artifact.Bytes - $offset) {
            throw "Unexpected Content-Length for $($Artifact.Name)."
        }
        $mode = if ($offset) { [IO.FileMode]::Append } else { [IO.FileMode]::Create }
        $target = [IO.File]::Open($Partial, $mode, 'Write', 'None')
        $source = $response.GetResponseStream()
        $buffer = [byte[]]::new(256KB)
        $received = $offset
        $progress = [Diagnostics.Stopwatch]::StartNew()
        $lastDisplayed = -1L
        $lastLogged = -30L
        Write-Host "$activity ($offset / $($Artifact.Bytes) bytes)."
        while (($read = $source.Read($buffer, 0, $buffer.Length)) -gt 0) {
            if ($progress.Elapsed.TotalHours -ge 4) { throw 'The download exceeded four hours.' }
            $received += $read
            if ($received -gt $Artifact.Bytes) { throw "Unexpected extra bytes for $($Artifact.Name)." }
            $target.Write($buffer, 0, $read)
            $seconds = [long][Math]::Floor($progress.Elapsed.TotalSeconds)
            if ($seconds -ne $lastDisplayed) {
                Write-Progress -Activity $activity -Status "$received / $($Artifact.Bytes) bytes" `
                    -PercentComplete ([Math]::Floor(100.0 * $received / $Artifact.Bytes))
                $lastDisplayed = $seconds
            }
            if ($seconds -ge $lastLogged + 30) {
                Write-Host "$activity ($received / $($Artifact.Bytes) bytes)."
                $lastLogged = $seconds
            }
        }
        $target.Flush($true)
        if ($received -ne $Artifact.Bytes) { throw "Incomplete download: $received / $($Artifact.Bytes) bytes." }
        Write-Host "$activity ($received / $($Artifact.Bytes) bytes)."
    } finally {
        if ($target) { $target.Dispose() }
        if ($source) { $source.Dispose() }
        if ($response) { $response.Dispose() }
        Write-Progress -Activity $activity -Completed
    }
}

function Save-Artifact($Artifact) {
    $target = Join-Path $cache $Artifact.Name
    if (Test-Path -LiteralPath $target) {
        Assert-ExamLabProtectedPath $target
        if (Test-Artifact $target $Artifact) {
            Write-Host "Verified cache: $($Artifact.Name)."
            return
        }
    }
    $partial = "$target.$($Artifact.SHA256).partial"
    if (Test-Path -LiteralPath $partial) { Assert-ExamLabProtectedPath $partial }
    if (-not (Test-Artifact $partial $Artifact)) {
        $supplied = Get-SuppliedArtifact $Artifact
        if ($supplied) {
            [IO.File]::Copy($supplied, $partial, $true)
            Write-Host "Imported $($Artifact.Name) from the supplied directory."
        } elseif ($offline) {
            throw "The offline cache is missing $($Artifact.Name)."
        } else {
            Receive-Artifact $Artifact $partial
        }
    }
    if (-not (Test-Artifact $partial $Artifact)) {
        [IO.File]::Delete($partial)
        throw "Package size or SHA-256 does not match: $($Artifact.Name)."
    }
    if ([IO.File]::Exists($target)) { [IO.File]::Replace($partial, $target, [NullString]::Value) }
    else { [IO.File]::Move($partial, $target) }
}

function Complete-DiagnosticArchive([string]$Directory) {
    $archive = Join-Path $Directory 'diagnostics.zip'
    if ([IO.File]::Exists($archive)) { return }
    $temporary = "$archive.partial"
    if ($admin -and (Test-Path -LiteralPath $temporary)) { Assert-ExamLabProtectedPath $temporary }
    [IO.File]::Delete($temporary)
    try {
        [IO.Compression.ZipFile]::CreateFromDirectory((Join-Path $Directory 'report'), $temporary)
        [IO.File]::Move($temporary, $archive)
    } finally { [IO.File]::Delete($temporary) }
}

function Complete-InterruptedDiagnostics([string]$Directory) {
    if ([IO.File]::Exists((Join-Path $Directory 'diagnostics.zip'))) { return }
    $startFile = Join-Path $Directory 'attempt-start.json'
    $receiverFile = Join-Path $Directory 'delivery-target.txt'
    $attemptLockPath = Join-Path $Directory 'attempt.lock'
    if (-not ([IO.File]::Exists($startFile) -and [IO.File]::Exists($receiverFile) -and
        [IO.File]::Exists($attemptLockPath))) { return }
    if ($admin) {
        foreach ($candidate in $startFile, $receiverFile, $attemptLockPath) { Assert-ExamLabProtectedPath $candidate }
    }
    if ([IO.File]::ReadAllText($receiverFile) -cne $receiver) { return }
    $previousLock = $null
    $childLock = $null
    try {
        try {
            $previousLock = [IO.File]::Open($attemptLockPath, 'Open', 'ReadWrite', 'None')
            $childLockPath = Join-Path $Directory 'child.lock'
            if ([IO.File]::Exists($childLockPath)) {
                if ($admin) { Assert-ExamLabProtectedPath $childLockPath }
                $childLock = [IO.File]::Open($childLockPath, 'Open', 'ReadWrite', 'None')
            }
        } catch [IO.IOException] { return }
        $previousReport = Join-Path $Directory 'report'
        if ($admin) { Assert-ExamLabProtectedPath $previousReport }
        $summary = Join-Path $previousReport 'attempt.json'
        if (-not [IO.File]::Exists($summary)) {
            $start = [IO.File]::ReadAllText($startFile) | ConvertFrom-Json
            [ordered]@{
                Attempt=$start.Attempt; Release=$start.Release; Action=$start.Action; StartedUtc=$start.StartedUtc
                Interrupted=$true; RecoveredUtc=[DateTime]::UtcNow
            } | ConvertTo-Json | Set-Content -LiteralPath $summary -Encoding UTF8
        }
        Complete-DiagnosticArchive $Directory
    } finally {
        if ($childLock) { $childLock.Dispose() }
        if ($previousLock) { $previousLock.Dispose() }
    }
}

function Send-Diagnostics([string]$Directory) {
    $archive = Join-Path $Directory 'diagnostics.zip'
    $receipt = Join-Path $Directory 'upload-result.json'
    $receiverFile = Join-Path $Directory 'delivery-target.txt'
    if ($offline -or -not (Test-Path -LiteralPath $archive -PathType Leaf) -or
        -not (Test-Path -LiteralPath $receiverFile -PathType Leaf)) { return }
    if ($admin) {
        Assert-ExamLabProtectedPath $archive
        Assert-ExamLabProtectedPath $receiverFile
    }
    if (-not $admin) {
        foreach ($candidate in $archive, $receiverFile) {
            if ((Get-Item -LiteralPath $candidate -Force).Attributes -band [IO.FileAttributes]::ReparsePoint) { return }
        }
    }
    if ([IO.File]::ReadAllText($receiverFile) -cne $receiver) { return }
    $length = (Get-Item -LiteralPath $archive -Force).Length
    if ($length -gt 8MB) { throw 'Размер ZIP превышает лимит приёмника 8 МиБ.' }
    $expectedId = (Get-FileHash -LiteralPath $archive -Algorithm SHA256).Hash.Substring(0, 32).ToLowerInvariant()
    if (Test-Path -LiteralPath $receipt -PathType Leaf) {
        if ($admin) { Assert-ExamLabProtectedPath $receipt }
        try {
            $saved = [IO.File]::ReadAllText($receipt) | ConvertFrom-Json
            if ($saved.reportId -ceq $expectedId) { return $expectedId }
        } catch { Write-Warning "Invalid diagnostics receipt in $Directory. Retrying the same ZIP." }
    }
    Start-BootstrapTransport
    $request = $transport.Request("$baseUrl/diagnostics")
    $request.Method = 'POST'
    $request.ContentType = 'application/zip'
    $request.AllowWriteStreamBuffering = $false
    $request.ServicePoint.Expect100Continue = $false
    $request.ContentLength = $length
    $archiveStream = [IO.File]::Open($archive, 'Open', 'Read', 'Read')
    try {
        $output = $request.GetRequestStream()
        try { $archiveStream.CopyTo($output) } finally { $output.Dispose() }
        $response = $request.GetResponse()
        try {
            if ([int]$response.StatusCode -ne 201) { throw "Unexpected diagnostics status $([int]$response.StatusCode)." }
            $reader = [IO.StreamReader]::new($response.GetResponseStream())
            try {
                $content = $reader.ReadToEnd()
                $id = ($content | ConvertFrom-Json).reportId
                if ($id -cne $expectedId) { throw 'Номер принятого архива не соответствует SHA-256 локального ZIP.' }
            } finally { $reader.Dispose() }
        } finally { $response.Dispose() }
        $temporary = "$receipt.$([Guid]::NewGuid().ToString('N')).tmp"
        try {
            [IO.File]::WriteAllText($temporary, $content)
            if ([IO.File]::Exists($receipt)) { [IO.File]::Replace($temporary, $receipt, [NullString]::Value) }
            else { [IO.File]::Move($temporary, $receipt) }
        } finally { [IO.File]::Delete($temporary) }
        Write-Host "Diagnostics accepted: $id"
        return $id
    } finally { $archiveStream.Dispose() }
}

function Invoke-EarlyCheck {
    $checkScript = Join-Path $work 'Prepare-ExamLab.ps1'
    [IO.File]::WriteAllBytes($checkScript, (Read-EmbeddedPowerShell 'EXAMLAB_EARLY_CHECK'))
    $checkReport = Join-Path $report 'early-check.json'
    $previousTemp = $env:TEMP
    $previousTmp = $env:TMP
    try {
        $env:TEMP = $env:TMP = $work
        $ErrorActionPreference = 'Continue'
        & (Join-Path $PSHOME 'powershell.exe') -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass `
            -File $checkScript -Action Check -HumanOutput -ReportPath $checkReport 2>&1 |
            ForEach-Object { [string]$_ } | Tee-Object -FilePath (Join-Path $report 'early-check.log') | Out-Host
        $script:checkExit = $LASTEXITCODE
    } finally {
        $env:TEMP = $previousTemp
        $env:TMP = $previousTmp
    }
    if (-not (Test-Path -LiteralPath $checkReport -PathType Leaf)) { throw "Check returned $checkExit without a report." }
    Get-Content -LiteralPath $checkReport -Raw | ConvertFrom-Json
}

function Get-ReleaseVolume([string]$Path) {
    $directory = $Path
    while ($directory -and -not [IO.Directory]::Exists($directory)) {
        $directory = [IO.Path]::GetDirectoryName($directory)
    }
    try {
        if (-not $directory) { throw 'No existing destination directory is accessible.' }
        Initialize-BootstrapTypes
        $volume = [ExamLabBootstrapVolume]::Read($directory)
        [pscustomobject]@{ Id=$volume.Id; MountPath=$volume.MountPath; FreeBytes=$volume.FreeBytes; Error=$null }
    } catch {
        $root = [IO.Path]::GetPathRoot($Path)
        [pscustomobject]@{ Id="Unknown:$root"; MountPath=$root; FreeBytes=$null; Error=$_.Exception.Message }
    }
}

function New-SpaceNeed([string]$Path, [string]$Kind, [long]$Bytes) {
    [pscustomobject]@{ Path=$Path; Kind=$Kind; Bytes=$Bytes }
}

function Get-InstallationSpaceNeeds($ReleasePlan, [bool]$RuntimeReady, $Warnings) {
    $windows = [Environment]::GetFolderPath('Windows')
    $programData = [Environment]::GetFolderPath('CommonApplicationData')
    $stage = $programFiles
    $software = $ReleasePlan.Software
    $downloaded = $ReleasePlan.Artifacts
    $names = 'LGPO.zip', 'PolicyFileEditor-3.0.1.zip', 'gradle-9.8.2-bin.zip', 'gradle-exam-cache.zip',
        'wazuh-agent-4.14.10-1.msi'
    $required = @{}
    foreach ($name in $names) { $required[$name] = $downloaded | Where-Object Name -ceq $name }

    New-SpaceNeed $stage 'SetupFiles' ($installer.Bytes + $bundle.ExpandedBytes)
    foreach ($name in 'LGPO.zip', 'PolicyFileEditor-3.0.1.zip') {
        $artifact = $required[$name]
        if ($artifact.ContainsKey('ExpandedBytes') -and $null -ne $artifact.ExpandedBytes) {
            New-SpaceNeed $stage 'SetupFiles' $artifact.ExpandedBytes
        } else { $Warnings.Add("Expanded archive size is unknown for $name.") }
    }

    foreach ($package in $software.Packages) {
        $artifact = $downloaded | Where-Object Name -ceq $package.File
        New-SpaceNeed $stage 'InstallerCopies' $artifact.Bytes
    }
    if ($software.PSObject.Properties['Size'] -and $software.Size) {
        foreach ($component in $software.Size.Components) {
            if ($component.Operation -eq 'Keep') { continue }
            $destination = $component.Destination
            if ($null -eq $component.AdditionalInstalledBytes -or -not $destination) {
                $Warnings.Add("Installed growth is unknown for $($component.Name).")
                continue
            }
            $payload = $software.Packages | Where-Object Name -ceq $component.Name
            $publishedPayload = if ($payload) { $downloaded | Where-Object Name -ceq $payload.File }
            if ($component.Name -eq 'Gradle' -and $publishedPayload -and $publishedPayload.ContainsKey('ExpandedBytes') -and
                $null -ne $publishedPayload.ExpandedBytes) {
                New-SpaceNeed $destination 'InstalledAssets' $publishedPayload.ExpandedBytes
                New-SpaceNeed $destination 'InstalledEstimates' ([Math]::Max(0L,
                    [long]$component.AdditionalInstalledBytes - [long]$publishedPayload.ExpandedBytes))
            } else { New-SpaceNeed $destination 'InstalledEstimates' $component.AdditionalInstalledBytes }
            if ($null -eq $component.StagingBytes) { $Warnings.Add("Installer working space is unknown for $($component.Name).") }
            else {
                $scratch = [Math]::Max(0L, [long]$component.StagingBytes - [long]$component.PayloadBytes)
                $scratchPath = $component.StagingDestination
                if ($payload -and $payload.File -like '*.msi') {
                    $scratchPath = $windows
                    New-SpaceNeed $windows 'InstalledEstimates' $publishedPayload.Bytes
                } elseif ($payload -and $payload.File -like '*.exe' -and $env:TEMP) { $scratchPath = $env:TEMP }
                if ($scratchPath) { New-SpaceNeed $scratchPath 'WorkingEstimates' $scratch }
                elseif ($scratch) { $Warnings.Add("Installer working volume is unknown for $($component.Name).") }
            }
        }
    } else { $Warnings.Add('Application installation sizes are unavailable.') }

    $sharedGradle = Join-Path $programFiles 'ExamLabGradleCache'
    $gradleCache = $required['gradle-exam-cache.zip']
    if (-not ((Test-Path -LiteralPath (Join-Path $sharedGradle '.exam-lab-cache') -PathType Leaf -ErrorAction SilentlyContinue) -and
        (Test-Path -LiteralPath (Join-Path $sharedGradle 'modules-2') -PathType Container -ErrorAction SilentlyContinue))) {
        if ($gradleCache.ContainsKey('ExpandedBytes') -and $null -ne $gradleCache.ExpandedBytes) {
            New-SpaceNeed $sharedGradle 'InstalledAssets' $gradleCache.ExpandedBytes
        } else { $Warnings.Add('Expanded Gradle dependency cache size is unknown.') }
    }
    $gradleLauncher = $required['gradle-9.8.2-bin.zip']
    $ideaRoot = Join-Path $programFiles 'ExamLabIdea'
    if (-not (Test-Artifact (Join-Path $ideaRoot $gradleLauncher.Name) $gradleLauncher)) {
        New-SpaceNeed $ideaRoot 'InstalledAssets' $gradleLauncher.Bytes
    }

    if (-not $RuntimeReady) {
        New-SpaceNeed (Split-Path -Parent $pwsh) 'InstalledEstimates' ([Math]::Max(256MB, 2L * $runtime.Bytes))
        New-SpaceNeed $windows 'InstalledEstimates' $runtime.Bytes
        New-SpaceNeed $windows 'WorkingEstimates' ([Math]::Max(128MB, $runtime.Bytes))
    }
    if (-not (Get-Service -Name 'WazuhSvc' -ErrorAction SilentlyContinue)) {
        $wazuh = $required['wazuh-agent-4.14.10-1.msi']
        New-SpaceNeed (Join-Path ([Environment]::GetFolderPath('ProgramFilesX86')) 'ossec-agent') 'InstalledEstimates' `
            ([Math]::Max(100MB, 2L * $wazuh.Bytes))
        New-SpaceNeed $windows 'InstalledEstimates' $wazuh.Bytes
        New-SpaceNeed $windows 'WorkingEstimates' ([Math]::Max(64MB, $wazuh.Bytes))
    }
    # The bundle and policy archives provide a conservative bound for stamps, code and side-by-side file updates.
    $examLabCodeBytes = [long]$bundle.ExpandedBytes
    foreach ($name in 'LGPO.zip', 'PolicyFileEditor-3.0.1.zip') {
        if ($required[$name].ContainsKey('ExpandedBytes')) { $examLabCodeBytes += [long]$required[$name].ExpandedBytes }
    }
    if (Test-Path -LiteralPath (Join-Path $programFiles 'ExamLab') -PathType Container -ErrorAction SilentlyContinue) {
        New-SpaceNeed $programFiles 'WorkingEstimates' $examLabCodeBytes
    } else { New-SpaceNeed $programFiles 'InstalledEstimates' $examLabCodeBytes }
    New-SpaceNeed $programData 'WorkingEstimates' 16MB
    New-SpaceNeed $programFiles 'WorkingEstimates' 32MB
}

function Test-ReleaseSpace($ReleasePlan, [bool]$RuntimeReady, [string]$Phase) {
    $warnings = [Collections.Generic.List[string]]::new()
    $cacheBytes = if ($Phase -eq 'Initial') { $ReleasePlan.Report.CacheGrowthUpperBoundBytes } else { 0L }
    $trustedCacheBytes = if ($Phase -eq 'Initial') { $ReleasePlan.Report.KnownCacheGrowthBytes } else { 0L }
    $needs = @(New-SpaceNeed $cache 'Cache' $cacheBytes)
    $needs += @(Get-InstallationSpaceNeeds $ReleasePlan $RuntimeReady $warnings)
    $volumes = @{}
    $resolvedPaths = @{}
    foreach ($need in $needs) {
        if (-not $resolvedPaths.ContainsKey($need.Path)) { $resolvedPaths[$need.Path] = Get-ReleaseVolume $need.Path }
        $volume = $resolvedPaths[$need.Path]
        if (-not $volumes.ContainsKey($volume.Id)) {
            $volumes[$volume.Id] = [ordered]@{
                Id=$volume.Id; MountPath=$volume.MountPath; FreeBytes=$volume.FreeBytes; Error=$volume.Error
                Cache=0L; SetupFiles=0L; InstallerCopies=0L; InstalledAssets=0L; InstalledEstimates=0L; WorkingEstimates=0L
            }
        }
        $row = $volumes[$volume.Id]
        if ($null -ne $volume.FreeBytes -and $volume.FreeBytes -lt $row.FreeBytes) { $row.FreeBytes = $volume.FreeBytes }
        $row[$need.Kind] += $need.Bytes
    }
    $cacheVolumeId = $resolvedPaths[$cache].Id
    $rows = foreach ($row in $volumes.Values | Sort-Object MountPath) {
        # The setup files stay present while installers run. Installer copies and the later Gradle assets need not coexist.
        $minimumCache = if ($row.Id -eq $cacheVolumeId) { $trustedCacheBytes } else { 0L }
        $minimum = $minimumCache + $row.SetupFiles + [Math]::Max($row.InstallerCopies, $row.InstalledAssets)
        $estimatedGrowth = $row.InstalledAssets + $row.InstalledEstimates
        $estimatedPeak = $row.Cache + $row.SetupFiles + $row.InstallerCopies + $estimatedGrowth + $row.WorkingEstimates
        $blockingThreshold = if ($action -eq 'Prefetch') { $minimumCache } else { $minimum }
        $status = 'Available'
        $reason = $null
        if ($null -eq $row.FreeBytes) { $status = 'Unknown'; $reason = $row.Error }
        elseif ($row.FreeBytes -lt $blockingThreshold) {
            $status = 'InsufficientSpace'
            $reason = "Free space is below the known requirement of $blockingThreshold bytes."
        } elseif ($row.FreeBytes -lt $estimatedPeak) {
            $status = 'EstimatedSpaceRisk'
            $reason = 'Available space is below the estimated installation peak.'
        }
        [pscustomobject]@{
            VolumeId=$row.Id; MountPath=$row.MountPath; AvailableBytes=$row.FreeBytes; Status=$status; Reason=$reason
            CacheGrowthBytes=$row.Cache; SetupStagingBytes=$row.SetupFiles; InstallerCopiesBytes=$row.InstallerCopies
            AdditionalInstalledBytes=$estimatedGrowth; OtherWorkingBytes=$row.WorkingEstimates
            KnownInstallationPeakBytes=$minimum; RequiredBytesForAction=$blockingThreshold; EstimatedPeakBytes=$estimatedPeak
        }
    }
    $installedGrowth = [long]0
    foreach ($row in $rows) { $installedGrowth += $row.AdditionalInstalledBytes }
    $measurement = [pscustomobject]@{
        Phase=$Phase; TimeUtc=[DateTime]::UtcNow; EstimatedAdditionalInstalledBytes=$installedGrowth
        Volumes=@($rows); Warnings=$warnings.ToArray()
    }
    $ReleasePlan.Report.SpaceChecks += $measurement
    $ReleasePlan.Report | ConvertTo-Json -Depth 9 |
        Set-Content -LiteralPath (Join-Path $report 'release-plan.json') -Encoding UTF8
    Write-Host "Disk space ($Phase). Estimated additional installed bytes: $installedGrowth."
    $rows | Format-Table @{Label='Volume';Expression={$_.MountPath}}, @{Label='Free bytes';Expression={$_.AvailableBytes}},
        @{Label='Cache bytes';Expression={$_.CacheGrowthBytes}}, @{Label='Install bytes';Expression={$_.AdditionalInstalledBytes}},
        @{Label='Peak estimate';Expression={$_.EstimatedPeakBytes}}, Status -AutoSize | Out-Host
    foreach ($row in $rows) {
        if ($row.Reason) { Write-Warning "$($row.MountPath) $($row.Reason)" }
    }
    foreach ($warning in $warnings) { Write-Warning $warning }
    return (-not @($rows | Where-Object Status -eq 'InsufficientSpace').Count)
}

function Remove-CachedReleaseInstallers {
    $records = foreach ($artifact in $tools | Where-Object { $_.Name -match '\.exe$' }) {
        $path = Join-Path $cache $artifact.Name
        $state = 'Absent'
        $reason = $null
        try {
            if (Test-Path -LiteralPath $path) {
                Assert-ExamLabProtectedPath $path
                if (-not (Test-Artifact $path $artifact)) { throw 'The file does not match the pinned release installer.' }
                [IO.File]::Delete($path)
                $state = 'Removed'
                Write-Host "Removed cached installer $($artifact.Name)."
            }
        } catch {
            $state = 'Retained'
            $reason = $_.Exception.Message
            Write-Warning "Cached installer cleanup left $($artifact.Name): $reason"
        }
        [pscustomobject]@{ Name=$artifact.Name; Status=$state; Bytes=$artifact.Bytes; Reason=$reason }
    }
    ConvertTo-Json -InputObject @($records) |
        Set-Content -LiteralPath (Join-Path $report 'installer-cleanup.json') -Encoding UTF8
}

function Get-ReleasePlan($Check, [bool]$RuntimeReady) {
    $plannedFiles = @($Check.Plan.Packages | ForEach-Object { $_.File })
    $requiredTools = @('LGPO.zip', 'PolicyFileEditor-3.0.1.zip', 'wazuh-agent-4.14.10-1.msi',
        'gradle-9.8.2-bin.zip', 'gradle-exam-cache.zip') + $plannedFiles
    $artifacts = @($installer, $bundle)
    if (-not $RuntimeReady) { $artifacts += $runtime }
    foreach ($name in $requiredTools | Select-Object -Unique) {
        $tool = @($tools | Where-Object { $_.Name -ceq $name })
        if ($tool.Count -ne 1) { throw "No pinned release artifact for $name." }
        $artifacts += $tool[0]
    }
    $rows = foreach ($artifact in $artifacts) {
        $target = Join-Path $cache $artifact.Name
        $status = 'UnknownWithoutElevation'
        $partialBytes = 0L
        $partialCredit = 0L
        if ($sharedCacheRead) {
            $status = 'Missing'
            if (Test-Path -LiteralPath $target) { Assert-ExamLabProtectedPath $target }
            if (Test-Artifact $target $artifact) { $status = 'Cached' }
            else {
                $partial = "$target.$($artifact.SHA256).partial"
                if (Test-Path -LiteralPath $partial) {
                    Assert-ExamLabProtectedPath $partial
                    $item = Get-Item -LiteralPath $partial -Force
                    if (Test-Artifact $partial $artifact) { $status = 'VerifiedPartial' }
                    elseif (-not $item.PSIsContainer -and $item.Length -gt 0) {
                        if ($item.Length -lt $artifact.Bytes) {
                            $status = 'Partial'
                            $partialBytes = $item.Length
                        }
                        if (-not ($item.Attributes -band ([IO.FileAttributes]::SparseFile -bor [IO.FileAttributes]::Compressed))) {
                            $partialCredit = [Math]::Min([long]$item.Length, [long]$artifact.Bytes)
                        }
                    }
                }
            }
        }
        $ready = $status -in 'Cached', 'VerifiedPartial'
        $supplied = (-not $ready) -and [bool](Get-SuppliedArtifact $artifact)
        $cacheGrowth = if ($ready) { 0L } else { [long]$artifact.Bytes - $partialCredit }
        $networkMaximum = if ($ready -or $supplied) { 0L } else { [long]$artifact.Bytes }
        [pscustomobject]@{
            Name=$artifact.Name; Bytes=$artifact.Bytes; CacheStatus=$status; Supplied=$supplied; PartialBytes=$partialBytes
            CacheGrowthBytes=$cacheGrowth; DownloadBytesIfRanges=$networkMaximum - [Math]::Min($networkMaximum, $partialBytes)
            DownloadUpperBoundBytes=$networkMaximum; RemoveAfterSuccessfulApply=$artifact.Name -match '\.exe$'
        }
    }
    $knownCacheGrowth = 0L
    $upperCacheGrowth = 0L
    $retainedCacheGrowth = 0L
    $downloadUpper = 0L
    $downloadWithRanges = 0L
    foreach ($row in $rows) {
        if ($row.CacheStatus -ne 'UnknownWithoutElevation') { $knownCacheGrowth += $row.CacheGrowthBytes }
        $upperCacheGrowth += $row.CacheGrowthBytes
        if (-not $row.RemoveAfterSuccessfulApply) { $retainedCacheGrowth += $row.CacheGrowthBytes }
        $downloadUpper += $row.DownloadUpperBoundBytes
        $downloadWithRanges += $row.DownloadBytesIfRanges
    }
    $plannedDownload = $null
    if (-not @($rows | Where-Object CacheStatus -eq 'UnknownWithoutElevation').Count) { $plannedDownload = $downloadWithRanges }
    $footprint = $null
    if ($Check.Plan.PSObject.Properties['Size'] -and $Check.Plan.Size -and
        $Check.Plan.Size.PSObject.Properties['EstimatedInstalledFootprintBytes']) { $footprint = $Check.Plan.Size.EstimatedInstalledFootprintBytes }
    $plan = [ordered]@{
        Release=$release; Attempt=$attempt; Action=$action; Elevated=$admin; Offline=$offline
        PowerShell7Ready=$RuntimeReady; PowerShell7Observation=$(if ($action -eq 'Check') { 'FileMetadataOnly' } else { 'RuntimeProbe' });
        Artifacts=@($rows); Transport='HTTPS; byte ranges tested during delivery'
        DownloadBytes=$plannedDownload; DownloadUpperBoundBytes=$downloadUpper
        KnownCacheGrowthBytes=$knownCacheGrowth; CacheGrowthUpperBoundBytes=$upperCacheGrowth
        RetainedCacheGrowthIfApplySucceedsBytes=$retainedCacheGrowth
        EstimatedSelectedApplicationFootprintBytes=$footprint; SpaceChecks=@()
    }
    Write-Host "PowerShell 7 ready: $RuntimeReady."
    $rows | Format-Table Name, Bytes, CacheStatus, Supplied, PartialBytes -AutoSize | Out-Host
    Write-Host "Online download upper bound: $downloadUpper bytes."
    if ($offline) { Write-Host 'Offline mode uses supplied or cached files.' }
    if ($null -ne $plannedDownload) { Write-Host "Expected network bytes when ranges are honored: $plannedDownload." }
    if ($null -ne $footprint) { Write-Host "Estimated installed footprint of selected applications: $footprint bytes." }
    return [pscustomobject]@{ Report=$plan; Artifacts=$artifacts; Software=$Check.Plan }
}

function Test-PowerShellRuntime {
    if (-not (Test-Path -LiteralPath $pwsh -PathType Leaf)) { return $false }
    if ($admin) {
        Assert-ExamLabProtectedPath ([IO.Path]::GetDirectoryName($pwsh)) -Readable
        Assert-ExamLabProtectedPath $pwsh -Readable
    }
    & $pwsh -NoLogo -NoProfile -NonInteractive -Command `
        'if ($PSVersionTable.PSVersion.Major -ne 7 -or $PSVersionTable.PSVersion -lt [semver]"@PWSH_VERSION@" -or $PSVersionTable.PSVersion.PreReleaseLabel -or -not [Environment]::Is64BitProcess) { exit 1 }' | Out-Host
    return $LASTEXITCODE -eq 0
}

function Test-PowerShellRuntimeMetadata {
    if (-not (Test-Path -LiteralPath $pwsh -PathType Leaf)) { return $false }
    try {
        $productVersion = [Diagnostics.FileVersionInfo]::GetVersionInfo($pwsh).ProductVersion
        if ($productVersion -notmatch '\A(7\.\d+\.\d+)(?:\z|[+ ])' -or
            [version]$Matches[1] -lt [version]'@PWSH_VERSION@') { return $false }
        $stream = [IO.File]::OpenRead($pwsh)
        try {
            $reader = [IO.BinaryReader]::new($stream)
            if ($reader.ReadUInt16() -ne 0x5A4D) { return $false }
            $stream.Position = 0x3C
            $header = $reader.ReadUInt32()
            if ($header -lt 0x40 -or $header -gt $stream.Length - 6) { return $false }
            $stream.Position = $header
            return $reader.ReadUInt32() -eq 0x4550 -and $reader.ReadUInt16() -eq 0x8664
        } finally { $stream.Dispose() }
    } catch { return $false }
}

function Invoke-Bootstrap {
    $check = Invoke-EarlyCheck
    $bootCheck = [Collections.Generic.List[string]]::new()
    if ($check.Platform) {
        $platform = $check.Platform
        $domain = if ($null -eq $platform.PartOfDomain) { 'unknown' } else { $platform.PartOfDomain }
        Write-Host "Windows $($platform.Edition), build $($platform.Build). Domain member: $domain. Elevated: $admin."
        $platform.OptionalObservations | ForEach-Object { Write-Host "Check: $_" }
        if (-not $platform.ClientWindows -or [int]$platform.Build -lt 19041) {
            $bootCheck.Add('The pilot requires a Windows client, build 19041 or newer.')
        }
        if ($platform.PartOfDomain -eq $true) { $bootCheck.Add('The pilot requires a standalone Windows computer.') }
    }
    if ($check.Preflight) {
        $check.Preflight.Services | Format-Table Name, Status, StartValue -AutoSize | Out-Host
        foreach ($service in @($check.Preflight.Services | Where-Object StartValue -eq 4)) {
            $bootCheck.Add("The required Windows service $($service.Name) is disabled.")
        }
        if ($admin -and $check.Preflight.LocalMLGPO.Status -eq 'AbsentBindings') {
            $bootCheck.Add('Windows Local Group Policy components are absent.')
        }
    }
    $setupAccount = $null
    $accountObservation = 'Unknown'
    try {
        $localAccounts = @(Get-LocalUser -ErrorAction Stop)
        $placeholder = $localAccounts | Where-Object Name -eq 'defaultuser0'
        if ($placeholder) {
            $setupAccount = [pscustomobject]@{ Present=$true; Enabled=[bool]$placeholder.Enabled }
            Write-Host 'Check: found the Windows Setup placeholder account. Enrollment will check Windows Setup state.'
        } else { $setupAccount = [pscustomobject]@{ Present=$false; Enabled=$null } }
        $accountObservation = 'Observed'
    } catch { $accountObservation = "Unknown: $_" }
    $taskObservation = 'NotCheckedWithoutElevation'
    if ($admin) {
        try {
            $tasks = @(Get-ScheduledTask -TaskPath '\' -ErrorAction Stop |
                Where-Object TaskName -in 'ExamLab-Local-prepare', 'ExamLab-Local-check', 'ExamLab-Local-exam',
                    'ExamLab-Local-normal', 'ExamLab-Controller-Poll' | Select-Object TaskName, State)
            $taskObservation = $tasks
            $tasks | Format-Table -AutoSize | Out-Host
        } catch { $taskObservation = "Unknown: $_" }
    }
    if ($check.Plan) {
        $check.Plan.Actions | Format-Table Name, Operation, ExistingVersion, ExistingPath, Destination -AutoSize | Out-Host
    }
    $check.Errors | ForEach-Object { Write-Host "Check: $_" }
    $bootCheck | ForEach-Object { Write-Host "Check: $_" }
    [ordered]@{
        Blockers=$bootCheck.ToArray(); NativeCheckExit=$checkExit; InstalledTasks=$taskObservation
        LocalAccounts=$accountObservation; WindowsSetupAccount=$setupAccount
    } | ConvertTo-Json |
        Set-Content -LiteralPath (Join-Path $report 'pilot-preflight.json') -Encoding UTF8
    if ($action -ne 'Verify' -and ($checkExit -ne 0 -or $bootCheck.Count)) {
        Write-Host "Check report: $report"
        if ($checkExit -ne 0) { return $checkExit }
        return 2
    }
    $runtimeReady = if ($action -eq 'Check') { Test-PowerShellRuntimeMetadata } else { Test-PowerShellRuntime }
    if ($action -ne 'Verify') {
        if (-not $check.Plan) { throw 'Check returned no installation plan.' }
        $releasePlan = Get-ReleasePlan $check $runtimeReady
        if (-not (Test-ReleaseSpace $releasePlan $runtimeReady 'Initial')) { return 2 }
        if ($action -eq 'Check') {
            Write-Host "Check report: $report"
            return 0
        }
        foreach ($artifact in $releasePlan.Artifacts) { Save-Artifact $artifact }
        if ($action -eq 'Prefetch') { return 0 }
        if (-not (Test-ReleaseSpace $releasePlan $runtimeReady 'AfterPrefetch')) { return 2 }
    }
    if (-not $runtimeReady) {
        if ($action -eq 'Verify') { throw 'PowerShell 7 x64 for this release is unavailable.' }
        if (Test-Path -LiteralPath (Join-Path $programFiles 'ExamLab')) {
            throw 'The existing ExamLab installation requires local maintenance before changing its PowerShell runtime.'
        }
        $msi = Join-Path $cache $runtime.Name
        $log = Join-Path $report 'PowerShell-msi.log'
        $signature = Get-AuthenticodeSignature -LiteralPath $msi
        if ($signature.Status -ne 'Valid' -or $signature.SignerCertificate.Subject -notmatch 'Microsoft Corporation') {
            throw "The PowerShell MSI signature did not pass verification: $($signature.Status)."
        }
        Write-Host 'Installing PowerShell 7 x64.'
        $process = Start-Process -FilePath (Join-Path ([Environment]::GetFolderPath('System')) 'msiexec.exe') `
            -ArgumentList "/i `"$msi`" /quiet /norestart USE_MU=0 ENABLE_MU=0 /L*v `"$log`"" -Wait -PassThru
        if ($process.ExitCode -ne 0) { return $process.ExitCode }
        if (-not (Test-PowerShellRuntime)) { throw 'The PowerShell 7 MSI ran, but the specified runtime did not pass verification.' }
        if (-not (Test-ReleaseSpace $releasePlan $true 'AfterRuntimeInstall')) { return 2 }
    }
    $entry = Join-Path $cache $installer.Name
    Assert-ExamLabProtectedPath $entry
    $localEntry = Join-Path $work 'Install-ExamLab.ps1'
    [IO.File]::Copy($entry, $localEntry)
    if (-not (Test-Artifact $localEntry $installer)) { throw 'The cached installer failed SHA-256 verification.' }
    $env:EXAMLAB_DIAGNOSTICS_DIR = $work
    $env:PSModulePath = (Join-Path ([IO.Path]::GetDirectoryName($pwsh)) 'Modules') + ';' + (Join-Path $PSHOME 'Modules')
    $arguments = @('-Action', $action)
    if ($offline) { $arguments += '-Offline' }
    $ErrorActionPreference = 'Continue'
    & $pwsh -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File $localEntry @arguments 2>&1 |
        ForEach-Object { [string]$_ } | Tee-Object -FilePath (Join-Path $report 'powershell-console.log') | Out-Host
    $applyExit = $LASTEXITCODE
    if ($action -eq 'Apply' -and $applyExit -eq 0) {
        try { Remove-CachedReleaseInstallers }
        catch { Write-Warning "Cached installer cleanup report unavailable: $_" }
    }
    return $applyExit
}

try {
    if ($admin) { New-ExamLabPrivateDirectory $work }
    else {
        $acl = [Security.AccessControl.DirectorySecurity]::new()
        $acl.SetAccessRuleProtection($true, $false)
        foreach ($sid in $identity.User.Value, 'S-1-5-18', 'S-1-5-32-544') {
            $acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new(
                [Security.Principal.SecurityIdentifier]::new($sid), 'FullControl', 'ContainerInherit, ObjectInherit', 'None', 'Allow'))
        }
        [void][IO.Directory]::CreateDirectory($work, $acl)
    }
    [void][IO.Directory]::CreateDirectory($report)
    [IO.File]::WriteAllText((Join-Path $work 'delivery-target.txt'), $receiver)
    $attemptLock = [IO.File]::Open((Join-Path $work 'attempt.lock'), 'CreateNew', 'ReadWrite', 'None')
    [ordered]@{ Attempt=$attempt; Release=$release; Action=$action; StartedUtc=[DateTime]::UtcNow } | ConvertTo-Json |
        Set-Content -LiteralPath (Join-Path $work 'attempt-start.json') -Encoding UTF8
    Start-Transcript -LiteralPath (Join-Path $report 'bootstrap.log') | Out-Null
    $transcribing = $true
    Write-Host "ExamLab $release, $action, attempt $attempt"
    if ($admin) {
        if ($action -in 'Prefetch', 'Apply') {
            $lockPath = Join-Path $programFiles '.exam-lab-bootstrap.lock'
            if (Test-Path -LiteralPath $lockPath) { Assert-ExamLabProtectedPath $lockPath -Readable }
            $lock = [IO.File]::Open($lockPath, 'OpenOrCreate', 'ReadWrite', 'None')
            if (-not (Test-Path -LiteralPath $reports)) { New-ExamLabPrivateDirectory $reports }
            Assert-ExamLabProtectedPath $reports
            if (-not (Test-Path -LiteralPath $cache)) { New-ExamLabPrivateDirectory $cache }
        }
        if (Test-Path -LiteralPath $reports) { Assert-ExamLabProtectedPath $reports }
        if (Test-Path -LiteralPath $cache) { Assert-ExamLabProtectedPath $cache }
        $sharedCacheRead = $true
    }
    $result = Invoke-Bootstrap
} catch {
    $failure = $_
    if (Test-Path -LiteralPath $report) {
        $failure | Format-List * -Force | Out-String -Width 360 |
            Set-Content -LiteralPath (Join-Path $report 'bootstrap-error.log') -Encoding UTF8
    }
    [Console]::Error.WriteLine($failure.ToString())
} finally {
    if (Test-Path -LiteralPath $report) {
        if ($action -eq 'Check') {
            Write-Host 'Собирается сводка Windows…'
            $inventoryReport = Join-Path $report 'inventory.txt'
            try { Invoke-ExamLabInventory $inventoryReport }
            catch {
                $_ | Format-List * -Force | Out-File -LiteralPath (Join-Path $report 'inventory-error.txt') -Encoding UTF8
                Write-Warning 'Сводка Windows собрана не полностью. Подробности будут в архиве.'
                if ($result -eq 0) { $result = 1 }
            }
        }
        try {
            if (-not (Test-Path -LiteralPath (Join-Path $report 'powershell-transcript.log'))) {
                $eventLog = Join-Path ([Environment]::GetFolderPath('System')) 'wevtutil.exe'
                $ErrorActionPreference = 'Continue'
                & $eventLog qe Application "/q:*[System[Provider[@Name='MsiInstaller'] and TimeCreated[timediff(@SystemTime) <= 900000]]]" `
                    /rd:true /c:30 /f:xml /e:Events 2>&1 | Out-File -LiteralPath (Join-Path $report 'bootstrap-msi-events.xml') -Encoding UTF8
                & $eventLog qe System "/q:*[System[Provider[@Name='Schannel'] and TimeCreated[timediff(@SystemTime) <= 900000]]]" `
                    /rd:true /c:30 /f:xml /e:Events 2>&1 | Out-File -LiteralPath (Join-Path $report 'bootstrap-schannel-events.xml') -Encoding UTF8
                $ErrorActionPreference = 'Stop'
            }
        } catch { Write-Warning "Native Windows events unavailable: $_" }
        Write-Host "Attempt $attempt finished with exit $result."
        if ($transcribing) { try { Stop-Transcript | Out-Null } catch { Write-Warning $_ } }
        $archive = Join-Path $work 'diagnostics.zip'
        $currentReceipt = $null
        try {
            [ordered]@{ Attempt=$attempt; Release=$release; Action=$action; ExitCode=$result; EndedUtc=[DateTime]::UtcNow } |
                ConvertTo-Json | Set-Content -LiteralPath (Join-Path $report 'attempt.json') -Encoding UTF8
            Add-Type -AssemblyName System.IO.Compression.FileSystem
            Complete-DiagnosticArchive $work
            $retryPrevious = -not $offline
            try { $currentReceipt = Send-Diagnostics $work }
            catch {
                Write-Warning "Diagnostic delivery is pending: $_"
                if ($_.Exception.InnerException -is [Net.WebException] -and -not $_.Exception.InnerException.Response) {
                    $retryPrevious = $false
                }
            }
            if ($retryPrevious) {
                $previous = Get-ChildItem -LiteralPath $attemptParent -Directory -Filter 'ExamLabBootstrap-*' |
                    Where-Object {
                        $_.Name -cmatch '^ExamLabBootstrap-[0-9a-f]{32}$' -and $_.FullName -ne $work -and
                            -not ($_.Attributes -band [IO.FileAttributes]::ReparsePoint)
                    }
                foreach ($directory in $previous) {
                    try {
                        if ($admin) {
                            Assert-ExamLabProtectedPath $directory.FullName
                            Complete-InterruptedDiagnostics $directory.FullName
                        }
                        $null = Send-Diagnostics $directory.FullName
                    } catch { Write-Warning "Diagnostic delivery is pending for $($directory.Name): $_" }
                }
            }
        } catch { Write-Warning "Diagnostic delivery is pending: $_" }
        if ($action -eq 'Check') {
            Write-Host ''
            Write-Host "Обследование ExamLab $($release.Substring(0, 12)) завершено."
            switch ($result) {
                0 { Write-Host 'Проверка предпосылок завершена. План подготовки сохранён.' }
                2 { Write-Host 'Найдены препятствия для подготовки. Причины сохранены в отчёте.' }
                default { Write-Host 'Часть проверок завершилась с ошибкой. Подробности сохранены в отчёте.' }
            }
            if ($currentReceipt) { Write-Host "Номер принятого архива $currentReceipt" }
            elseif ([IO.File]::Exists($archive)) { Write-Host 'Архив не отправлен. Передайте его владельцу стенда закрытым способом.' }
            if ([IO.File]::Exists($inventoryReport)) { Write-Host "Сводка $inventoryReport" }
            if ([IO.File]::Exists($archive)) { Write-Host "Локальный ZIP $archive" }
            else { Write-Host "Локальные материалы $work" }
        } else { Write-Host "Local diagnostics: $work" }
    }
    if ($transportStarted) { $transport.Dispose() }
    if ($attemptLock) { $attemptLock.Dispose() }
    if ($lock) { $lock.Dispose() }
}
if ($result -eq 3010) { Write-Host 'Restart Windows, then run the same verified Start-ExamLab.cmd again.' }
exit $result
